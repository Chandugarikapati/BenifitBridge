# BenefitBridge Environment Configuration

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://chandu_33:@localhost:5432/benefitbridge?schema=public"

# Authentication & Sessions
JWT_SECRET="super-secret-benefitbridge-jwt-key-minimum-32-chars-long!"
SESSION_MAX_AGE_SECONDS=604800

# Google Gemini API (Accessed server-side only)
# If not set, system will gracefully fall back to deterministic verified scheme knowledge
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Demonstration Flags
NEXT_PUBLIC_ENABLE_DEMO_DATA="true"
